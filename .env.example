# ==============================================================
# Team Task Manager - Environment Configuration Template
# Copy this file to .env in both root or respective folders:
# - server/.env
# - client/.env
# ==============================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL / Google Cloud SQL)
# Provide standard PostgreSQL connection URL or discrete parameters
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/team_task_manager
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=team_task_manager

# Fallback in-memory database simulation for local dev when PostgreSQL is offline
# Set to 'false' in production or when running with real PostgreSQL
USE_LOCAL_FALLBACK_IF_NO_PG=true

# Session Management
SESSION_SECRET=replace_with_a_secure_random_string_in_production
SESSION_MAX_AGE_MS=86400000

# Client Application URL (For CORS and redirect protection)
CLIENT_URL=http://localhost:5173

# Frontend Environment Variables (used by client Vite app)
# VITE_API_BASE_URL=http://localhost:5000/api
