# ==============================================================
# Team Task Manager - Environment Configuration Template
# Copy this file to server/.env for local development.
# ==============================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL / Google Cloud SQL)
# Either a connection URL...
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/team_task_manager
# ...or discrete parameters (used only when DATABASE_URL is not set)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=team_task_manager
# DB_SSL=true            # enable for public-IP Cloud SQL connections

# Development only: if PostgreSQL is unreachable, run on an in-memory database
# (pg-mem) with in-memory sessions. Never used when NODE_ENV=production.
USE_LOCAL_FALLBACK_IF_NO_PG=true

# Session Management (SESSION_SECRET is REQUIRED in production)
SESSION_SECRET=replace_with_a_long_random_string
SESSION_MAX_AGE_MS=86400000
# COOKIE_SAME_SITE=lax   # use "none" only if the frontend is on a different domain

# Allowed browser origin(s) for CORS, comma-separated.
# Same-origin requests (the production setup) are always allowed.
CLIENT_URL=http://localhost:5173

# Seed demo users/teams/tasks on start-up (always on outside production)
# SEED_DEMO_DATA=true

# Frontend (client/.env) - only needed if the API is on a different origin
# VITE_API_BASE_URL=http://localhost:5000/api
